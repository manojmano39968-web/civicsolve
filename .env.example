# CivicSolve V2 — Free Staging Environment Variables
# Copy to .env or configure in your Cloud Hosting dashboard (Render / Railway / Koyeb)

# Runtime Environment
NODE_ENV=production
PORT=10000

# Database: Neon PostgreSQL Connection String (Free Serverless Tier)
# Copy directly from your Neon Console (https://console.neon.tech)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-PROJECT.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication Secrets (Must be random, unique strings at least 32 characters long)
# You can generate them with: openssl rand -base64 32
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
JWT_REFRESH_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long

# Web Security & Reverse Proxy
# For unified deployment (frontend + backend on the same Render service):
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
TRUST_PROXY=true
ALLOWED_ORIGINS=https://civicsolve-v2.onrender.com
