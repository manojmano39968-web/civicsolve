# CivicSolve Environment Configuration Template
# Copy this file to .env for local overrides, or set these in your Render / Cloud dashboard.

# ==============================================================================
# BACKEND SERVICE (civicsolve-backend)
# ==============================================================================
PORT=5000
NODE_ENV=production
CORS_ORIGIN=*

# AI Microservice URL (Point to your deployed Fast API service on Render)
# Local: http://127.0.0.1:8000
# Production: https://civicsolve-ai.onrender.com
AI_SERVICE_URL=http://127.0.0.1:8000

# Database URL
# Local: leave empty to use zero-config SQLite fallback (database/civicsolve.db)
# Production: Set to your Render PostgreSQL Internal/External Connection String
# Example: postgresql://civicsolve_user:password@dpg-xxxx.render.com/civicsolve_db
DATABASE_URL=
DB_CLIENT=sqlite

# ==============================================================================
# FRONTEND SERVICE (civicsolve-frontend)
# ==============================================================================
# Base URL for API requests.
# Local Dev: Leave empty to use Vite's reverse proxy (/api)
# Production: Set to your public backend URL (e.g. https://civicsolve-backend.onrender.com/api)
VITE_API_BASE_URL=

# ==============================================================================
# AI SERVICE (civicsolve-ai)
# ==============================================================================
# Fast API runs on PORT provided by Render (e.g., 10000 or 8000)
PORT=8000
