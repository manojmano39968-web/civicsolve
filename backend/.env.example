# CivicSolve V2 Backend Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
# Leave DATABASE_URL commented out for automatic local SQLite (.data/civicsolve.db)
# Or provide PostgreSQL connection string for staging/production (e.g. Neon serverless postgres):
# DATABASE_URL=postgresql://neondb_owner:password@ep-cold-pond-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Secrets (REQUIRED: Must be at least 32 characters in production)
JWT_ACCESS_SECRET=dev_jwt_access_secret_civicsolve_v2_min_32_chars_long!
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_civicsolve_v2_min_32_chars_long!

# CORS & Cookies
# Allowed comma-separated origins (if backend and frontend are on different domains):
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Cookie security: true in production/HTTPS
COOKIE_SECURE=false
# Cookie SameSite: 'lax' for unified/same-origin deployment; 'none' if frontend and backend are hosted on separate domains
COOKIE_SAME_SITE=lax
# Trust proxy: true when behind a reverse proxy (Render, Vercel, Railway, AWS ALB, Nginx)
TRUST_PROXY=false
