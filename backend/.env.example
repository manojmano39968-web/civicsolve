# CivicSolve V2 Backend Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
# Leave DATABASE_URL commented out for automatic local SQLite (.data/civicsolve.db)
# Or provide PostgreSQL connection string for production:
# DATABASE_URL=postgres://user:password@localhost:5432/civicsolve

# JWT Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET=dev_jwt_access_secret_civicsolve_v2_min_32_chars_long!
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_civicsolve_v2_min_32_chars_long!

# CORS & Cookies
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
COOKIE_SECURE=false
